<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_contract_view_form_inherit_havano" model="ir.ui.view">
        <field name="name">hr.version.form.inherit.havano</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_contract_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='salary_info']" position="inside">
                <group string="Recurring Deductions" name="recurring_deductions">
                    <field name="hao_allow_multi_payroll_currency" invisible="1"/>
                    <label for="hao_medical_aid_amount"/>
                    <div class="o_row" name="hao_medical_aid_amount">
                        <field name="hao_medical_aid_amount" class="oe_inline o_hr_narrow_field" widget="monetary" options="{'currency_field': 'hao_medical_aid_currency_id'}"/>
                        <field name="hao_medical_aid_currency_id" class="oe_inline o_hr_narrow_field" nolabel="1" readonly="not hao_allow_multi_payroll_currency"/>
                    </div>
                    <label for="hao_funeral_policy_amount"/>
                    <div class="o_row" name="hao_funeral_policy_amount">
                        <field name="hao_funeral_policy_amount" class="oe_inline o_hr_narrow_field" widget="monetary" options="{'currency_field': 'hao_funeral_policy_currency_id'}"/>
                        <field name="hao_funeral_policy_currency_id" class="oe_inline o_hr_narrow_field" nolabel="1" readonly="not hao_allow_multi_payroll_currency"/>
                    </div>
                </group>
                <group string="Currency &amp; Split Payment Setup" name="hao_contract_currency_setup">
                    <field name="hao_currency_payment_setup" widget="radio" options="{'horizontal': true}"/>
                    <field name="hao_enable_split_pay" invisible="hao_currency_payment_setup != 'dual'"/>
                    <field name="hao_dual_currency_method" widget="radio" options="{'horizontal': true}"
                           invisible="hao_currency_payment_setup != 'dual'"/>
                    <separator string="Primary Currency" invisible="hao_currency_payment_setup != 'dual'"/>
                    <field name="hao_primary_currency_id" options="{'no_create': True}"
                           invisible="hao_currency_payment_setup != 'dual'"/>
                    <field name="hao_primary_amount" widget="monetary" options="{'currency_field': 'hao_primary_currency_id'}"
                           invisible="hao_currency_payment_setup != 'dual' or hao_dual_currency_method != 'exact'"/>
                    <field name="hao_primary_percentage"
                           invisible="hao_currency_payment_setup != 'dual' or hao_dual_currency_method != 'percentage'"/>
                    <separator string="Secondary Currency" invisible="hao_currency_payment_setup != 'dual'"/>
                    <field name="hao_secondary_currency_id" options="{'no_create': True}"
                           invisible="hao_currency_payment_setup != 'dual'"/>
                    <field name="hao_secondary_amount" widget="monetary" options="{'currency_field': 'hao_secondary_currency_id'}"
                           invisible="hao_currency_payment_setup != 'dual' or hao_dual_currency_method != 'exact'"/>
                    <field name="hao_secondary_percentage"
                           invisible="hao_currency_payment_setup != 'dual' or hao_dual_currency_method != 'percentage'"/>
                </group>
                <group string="Allowance &amp; Rule Currency Splits" name="hao_rule_splits_group" colspan="2" invisible="hao_currency_payment_setup != 'dual'">
                    <field name="hao_rule_split_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="salary_rule_id" options="{'no_create': True}"/>
                            <field name="split_method"/>
                            <field name="total_amount"/>
                            <field name="primary_percentage" invisible="split_method != 'percentage'"/>
                            <field name="secondary_percentage" invisible="split_method != 'percentage'"/>
                            <field name="primary_amount" widget="monetary" options="{'currency_field': 'primary_currency_id'}"/>
                            <field name="secondary_amount" widget="monetary" options="{'currency_field': 'secondary_currency_id'}"/>
                            <field name="primary_currency_id" column_invisible="1"/>
                            <field name="secondary_currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
