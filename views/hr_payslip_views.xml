    <record id="hr_payroll_edit_payslip_lines_form_wizard_inherit_havano" model="ir.ui.view">
        <field name="name">hr.payroll.edit.payslip.lines.wizard.view.form.inherit.havano</field>
        <field name="model">hr.payroll.edit.payslip.lines.wizard</field>
        <field name="inherit_id" ref="hr_payroll.hr_payroll_edit_payslip_lines_form_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='worked_days_line_ids']/list/field[@name='amount']" position="attributes">
                <attribute name="widget">monetary</attribute>
                <attribute name="options">{'currency_field': 'currency_id'}</attribute>
                <attribute name="string">Amount (USD)</attribute>
            </xpath>
            <xpath expr="//field[@name='worked_days_line_ids']/list/field[@name='amount']" position="after">
                <field name="currency_id" column_invisible="True"/>
                <field name="hao_secondary_currency_id" column_invisible="True"/>
                <field name="hao_secondary_amount" optional="show" column_invisible="not parent.hao_allow_multi_payroll_currency" string="Amount (ZWG)" widget="monetary" options="{'currency_field': 'hao_secondary_currency_id'}"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='amount']" position="attributes">
                <attribute name="widget">monetary</attribute>
                <attribute name="options">{'currency_field': 'currency_id'}</attribute>
                <attribute name="string">Amount (USD)</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='amount']" position="after">
                <field name="currency_id" column_invisible="True"/>
                <field name="hao_secondary_currency_id" column_invisible="True"/>
                <field name="hao_secondary_amount" optional="show" column_invisible="not parent.hao_allow_multi_payroll_currency" string="Amount (ZWG)" widget="monetary" options="{'currency_field': 'hao_secondary_currency_id'}"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='total']" position="attributes">
                <attribute name="widget">monetary</attribute>
                <attribute name="options">{'currency_field': 'currency_id'}</attribute>
                <attribute name="string">Total (USD)</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='total']" position="after">
                <field name="hao_secondary_total" optional="show" column_invisible="not parent.hao_allow_multi_payroll_currency" string="Total (ZWG)" widget="monetary" options="{'currency_field': 'hao_secondary_currency_id'}"/>
                <field name="hao_allow_multi_payroll_currency" column_invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='worked_days_line_ids']" position="before">
                <field name="hao_allow_multi_payroll_currency" invisible="1"/>
            </xpath>
        </field>
    </record>
