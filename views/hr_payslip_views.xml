<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_havano_payslip" model="report.paperformat">
        <field name="name">Havano Payslip Format</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="hr_payroll.action_report_payslip" model="ir.actions.report">
        <field name="paperformat_id" ref="havano_payroll.paperformat_havano_payslip"/>
    </record>

    <template id="hr_payroll.report_payslip">
        <t t-call="web.basic_layout">
            <div class="page showline-wrap" style="font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 12.5px; color: #111827; width: 100%; margin: 0; padding: 0;">
                
                <style>
                    /* Showline V3: Eliminate phantom table cell borders and gridlines in wkhtmltopdf */
                    .o_ignore_layout_styling,
                    table.o_ignore_layout_styling,
                    table.o_ignore_layout_styling tr,
                    table.o_ignore_layout_styling th,
                    table.o_ignore_layout_styling td {
                        border-collapse: separate !important;
                        border-spacing: 0 !important;
                        border: none !important;
                        border-style: none !important;
                    }
                    table {
                        border-collapse: separate !important;
                        border-spacing: 0 !important;
                        border: none !important;
                        border-style: none !important;
                    }
                    table th, table td {
                        border: none !important;
                        border-style: none !important;
                    }
                </style>

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- HEADER ROW 1: Centered Document Title                      -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <div style="text-align: center; font-size: 24px; font-weight: 700; letter-spacing: 4px; color: #111827; padding: 4px 0 2px 0; text-transform: uppercase;">
                    <span style="font-size: 15px; opacity: 0.35; letter-spacing: 2px; margin-right: 10px;">&#9472;&#9472;</span>
                    PAYSLIP
                    <span style="font-size: 15px; opacity: 0.35; letter-spacing: 2px; margin-left: 10px;">&#9472;&#9472;</span>
                </div>

                <!-- Accent divider line under title -->
                <div style="height: 1.5px; background-color: #111827; margin: 4px 0 16px 0;"/>

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- HEADER ROW 2: Company Logo & Details (Floated Divs)        -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <div style="width: 100%; margin-bottom: 16px; overflow: hidden; clear: both;">
                    <!-- LEFT: Logo -->
                    <div style="float: left; width: 35%; text-align: left; padding-top: 5px;">
                        <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)"
                             style="max-height: 85px; max-width: 180px; object-fit: contain;" alt="Logo"/>
                        <h3 t-else="" style="color: #111827; font-weight: 700; margin: 0; font-size: 18px;"><span t-field="o.company_id.name"/></h3>
                    </div>

                    <!-- RIGHT: Full Company Details -->
                    <div style="float: right; width: 63%; text-align: right;">
                        <div style="display: inline-block; text-align: left;">
                            <div style="font-size: 15px; font-weight: 700; color: #111827; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px;">
                                <span t-field="o.company_id.name"/>
                            </div>
                            <div style="font-size: 12px; font-weight: 400; color: #374151; line-height: 1.5;">
                                <t t-set="addr_items" t-value="[]"/>
                                <t t-if="o.company_id.street"><t t-set="addr_items" t-value="addr_items + [o.company_id.street]"/></t>
                                <t t-if="o.company_id.city"><t t-set="addr_items" t-value="addr_items + [o.company_id.city]"/></t>
                                <t t-if="o.company_id.country_id"><t t-set="addr_items" t-value="addr_items + [o.company_id.country_id.name]"/></t>
                                <div t-if="addr_items"><span t-esc="', '.join(addr_items)"/></div>
                                <div t-if="o.company_id.phone"><span style="font-weight: 500;">Phone: </span><span t-field="o.company_id.phone"/></div>
                                <div t-if="o.company_id.email"><span style="font-weight: 500;">Email: </span><span t-field="o.company_id.email"/></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Subtle Section Divider -->
                <div style="height: 1px; background-color: #e5e7eb; margin-bottom: 16px; clear: both;"/>

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- DETAILS ROW: Employee + Payslip Summary (Showline V3 style)-->
                <!-- ══════════════════════════════════════════════════════════ -->
                <div style="width: 100%; margin-bottom: 18px; overflow: hidden; clear: both;">
                    <!-- EMPLOYEE DETAILS -->
                    <div style="float: left; width: 48%; box-sizing: border-box;">
                        <div style="background: transparent; color: #1f2937; font-weight: 600; padding: 5px 4px; font-size: 12px; letter-spacing: 0.5px; border-top: 1px solid #4b5563; border-bottom: 1px solid #4b5563; text-transform: uppercase;">
                            EMPLOYEE DETAILS
                        </div>
                        <div style="border-bottom: 1px solid #f1f5f9; padding: 5px 4px; overflow: hidden; clear: both;">
                            <div style="float: left; width: 34%; font-weight: 700; color: #111827; font-size: 12px;">Name</div>
                            <div style="float: left; width: 66%; font-weight: 500; color: #111827; font-size: 12px;"><span t-field="o.employee_id.name"/></div>
                        </div>
                        <div t-if="o.employee_id.job_title" style="border-bottom: 1px solid #f1f5f9; padding: 5px 4px; overflow: hidden; clear: both;">
                            <div style="float: left; width: 34%; font-weight: 700; color: #111827; font-size: 12px;">Job Title</div>
                            <div style="float: left; width: 66%; font-weight: 400; color: #374151; font-size: 12px;"><span t-field="o.employee_id.job_title"/></div>
                        </div>
                        <div t-if="o.employee_id.department_id" style="border-bottom: 1px solid #f1f5f9; padding: 5px 4px; overflow: hidden; clear: both;">
                            <div style="float: left; width: 34%; font-weight: 700; color: #111827; font-size: 12px;">Department</div>
                            <div style="float: left; width: 66%; font-weight: 400; color: #374151; font-size: 12px;"><span t-field="o.employee_id.department_id.name"/></div>
                        </div>
                        <div t-if="o.employee_id.identification_id" style="border-bottom: 1px solid #f1f5f9; padding: 5px 4px; overflow: hidden; clear: both;">
                            <div style="float: left; width: 34%; font-weight: 700; color: #111827; font-size: 12px;">National ID</div>
                            <div style="float: left; width: 66%; font-weight: 400; color: #374151; font-size: 12px;"><span t-field="o.employee_id.identification_id"/></div>
                        </div>
                    </div>

                    <!-- PAYSLIP SUMMARY & LEAVE DETAILS -->
                    <div style="float: right; width: 48%; box-sizing: border-box;">
                        <div style="background: transparent; color: #1f2937; font-weight: 600; padding: 5px 4px; font-size: 12px; letter-spacing: 0.5px; border-top: 1px solid #4b5563; border-bottom: 1px solid #4b5563; text-transform: uppercase;">
                            PAYSLIP SUMMARY
                        </div>
                        <div style="border-bottom: 1px solid #f1f5f9; padding: 5px 4px; overflow: hidden; clear: both;">
                            <div style="float: left; width: 38%; font-weight: 700; color: #111827; font-size: 12px;">Payslip No.</div>
                            <div style="float: left; width: 62%; font-weight: 500; color: #111827; font-size: 12px;"><span t-field="o.name"/></div>
                        </div>
                        <div style="border-bottom: 1px solid #f1f5f9; padding: 5px 4px; overflow: hidden; clear: both;">
                            <div style="float: left; width: 38%; font-weight: 700; color: #111827; font-size: 12px;">Pay Period</div>
                            <div style="float: left; width: 62%; font-weight: 400; color: #374151; font-size: 12px;"><span t-field="o.date_from"/> to <span t-field="o.date_to"/></div>
                        </div>
                        <div style="border-bottom: 1px solid #f1f5f9; padding: 5px 4px; overflow: hidden; clear: both;">
                            <div style="float: left; width: 38%; font-weight: 700; color: #111827; font-size: 12px;">Wage Type</div>
                            <div style="float: left; width: 62%; font-weight: 400; color: #374151; font-size: 12px;"><span t-field="o.wage_type"/></div>
                        </div>
                        <div style="border-bottom: 1px solid #f1f5f9; padding: 5px 4px; overflow: hidden; clear: both;">
                            <div style="float: left; width: 38%; font-weight: 700; color: #111827; font-size: 12px;">Leave (Days)</div>
                            <div style="float: left; width: 62%; font-weight: 400; color: #374151; font-size: 12px;">
                                Alloc: <strong style="color: #111827;"><span t-esc="round(o.annual_leave_allocated, 1)"/></strong> |
                                Used: <span t-esc="round(o.annual_leave_taken, 1)"/> |
                                Bal: <strong style="color: #047857;"><span t-esc="round(o.annual_leave_balance, 1)"/></strong>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- SALARY COMPUTATION: EARNINGS & DEDUCTIONS TABLES           -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <t t-set="tax_credit_lines" t-value="o.line_ids.filtered(lambda l: l.appears_on_payslip and (l.category_id.code == 'TAX_CREDIT' or 'tax credit' in l.salary_rule_id.name.lower()) and (l.total != 0.0 or l.hao_secondary_total != 0.0))"/>
                <t t-set="earnings_lines" t-value="o.line_ids.filtered(lambda l: l.appears_on_payslip and l.category_id.code in ('BASIC', 'ALW') and l.id not in tax_credit_lines.ids and (l.total != 0.0 or l.hao_secondary_total != 0.0))"/>
                <t t-set="total_earnings_usd" t-value="sum(earnings_lines.mapped('total'))"/>
                <t t-set="total_earnings_zwg" t-value="sum(earnings_lines.mapped('hao_secondary_total'))"/>
                
                <t t-set="deductions_lines" t-value="o.line_ids.filtered(lambda l: l.appears_on_payslip and l.category_id.code == 'DED' and (l.total != 0.0 or l.hao_secondary_total != 0.0))"/>
                <t t-set="total_deductions_usd" t-value="abs(sum(deductions_lines.mapped('total')))"/>
                <t t-set="total_deductions_zwg" t-value="abs(sum(deductions_lines.mapped('hao_secondary_total')))"/>

                <div style="width: 100%; margin-bottom: 20px; overflow: hidden; clear: both;">
                    <!-- LEFT COLUMN: EARNINGS -->
                    <div style="float: left; width: 48%; box-sizing: border-box;">
                        <table class="o_ignore_layout_styling" style="width: 100%; border-collapse: separate !important; border-spacing: 0 !important; border: none !important;">
                            <thead>
                                <tr>
                                    <th style="padding: 7px 8px; text-align: left; color: #1f2937; font-weight: 600; font-size: 12px; border-top: 1px solid #4b5563 !important; border-bottom: 1px solid #4b5563 !important; border-left: none !important; border-right: none !important; border-style: solid none !important; text-transform: uppercase;">Earnings</th>
                                    <th style="padding: 7px 8px; text-align: right; color: #1f2937; font-weight: 600; font-size: 12px; border-top: 1px solid #4b5563 !important; border-bottom: 1px solid #4b5563 !important; border-left: none !important; border-right: none !important; border-style: solid none !important; text-transform: uppercase;">Amount (<span t-esc="o.currency_id.symbol or o.currency_id.name"/>)</th>
                                    <th t-if="o.company_id.hao_allow_multi_payroll_currency" style="padding: 7px 8px; text-align: right; color: #1f2937; font-weight: 600; font-size: 12px; border-top: 1px solid #4b5563 !important; border-bottom: 1px solid #4b5563 !important; border-left: none !important; border-right: none !important; border-style: solid none !important; text-transform: uppercase;">Amount (<span t-esc="o.company_id.hao_secondary_payroll_currency_id.symbol or o.company_id.hao_secondary_payroll_currency_id.name"/>)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="earnings_lines" t-as="line">
                                    <tr>
                                        <td style="padding: 7px 8px; font-size: 12px; color: #1f2937; border-bottom: 1px solid #f1f5f9 !important; border-top: none !important; border-left: none !important; border-right: none !important; border-style: none none solid none !important;">
                                            <span t-field="line.name"/>
                                        </td>
                                        <td style="padding: 7px 8px; text-align: right; font-size: 12px; color: #111827; font-weight: 500; border-bottom: 1px solid #f1f5f9 !important; border-top: none !important; border-left: none !important; border-right: none !important; border-style: none none solid none !important;">
                                            <span t-esc="line.total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td t-if="o.company_id.hao_allow_multi_payroll_currency" style="padding: 7px 8px; text-align: right; font-size: 12px; color: #111827; font-weight: 500; border-bottom: 1px solid #f1f5f9 !important; border-top: none !important; border-left: none !important; border-right: none !important; border-style: none none solid none !important;">
                                            <span t-esc="line.hao_secondary_total" t-options='{"widget": "monetary", "display_currency": o.company_id.hao_secondary_payroll_currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td style="padding: 8px 8px; font-weight: 700; font-size: 12.5px; color: #111827; border-top: 1px solid #4b5563 !important; border-bottom: 1px solid #4b5563 !important; border-left: none !important; border-right: none !important; border-style: solid none !important;">Total Earnings</td>
                                    <td style="padding: 8px 8px; text-align: right; font-weight: 700; font-size: 12.5px; color: #111827; border-top: 1px solid #4b5563 !important; border-bottom: 1px solid #4b5563 !important; border-left: none !important; border-right: none !important; border-style: solid none !important;">
                                        <span t-esc="total_earnings_usd" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                    <td t-if="o.company_id.hao_allow_multi_payroll_currency" style="padding: 8px 8px; text-align: right; font-weight: 700; font-size: 12.5px; color: #111827; border-top: 1px solid #4b5563 !important; border-bottom: 1px solid #4b5563 !important; border-left: none !important; border-right: none !important; border-style: solid none !important;">
                                        <span t-esc="total_earnings_zwg" t-options='{"widget": "monetary", "display_currency": o.company_id.hao_secondary_payroll_currency_id}'/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- RIGHT COLUMN: DEDUCTIONS -->
                    <div style="float: right; width: 48%; box-sizing: border-box;">
                        <table class="o_ignore_layout_styling" style="width: 100%; border-collapse: separate !important; border-spacing: 0 !important; border: none !important;">
                            <thead>
                                <tr>
                                    <th style="padding: 7px 8px; text-align: left; color: #1f2937; font-weight: 600; font-size: 12px; border-top: 1px solid #4b5563 !important; border-bottom: 1px solid #4b5563 !important; border-left: none !important; border-right: none !important; border-style: solid none !important; text-transform: uppercase;">Deductions</th>
                                    <th style="padding: 7px 8px; text-align: right; color: #1f2937; font-weight: 600; font-size: 12px; border-top: 1px solid #4b5563 !important; border-bottom: 1px solid #4b5563 !important; border-left: none !important; border-right: none !important; border-style: solid none !important; text-transform: uppercase;">Amount (<span t-esc="o.currency_id.symbol or o.currency_id.name"/>)</th>
                                    <th t-if="o.company_id.hao_allow_multi_payroll_currency" style="padding: 7px 8px; text-align: right; color: #1f2937; font-weight: 600; font-size: 12px; border-top: 1px solid #4b5563 !important; border-bottom: 1px solid #4b5563 !important; border-left: none !important; border-right: none !important; border-style: solid none !important; text-transform: uppercase;">Amount (<span t-esc="o.company_id.hao_secondary_payroll_currency_id.symbol or o.company_id.hao_secondary_payroll_currency_id.name"/>)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="deductions_lines" t-as="line">
                                    <tr>
                                        <td style="padding: 7px 8px; font-size: 12px; color: #1f2937; border-bottom: 1px solid #f1f5f9 !important; border-top: none !important; border-left: none !important; border-right: none !important; border-style: none none solid none !important;">
                                            <span t-field="line.name"/>
                                        </td>
                                        <td style="padding: 7px 8px; text-align: right; font-size: 12px; color: #111827; font-weight: 500; border-bottom: 1px solid #f1f5f9 !important; border-top: none !important; border-left: none !important; border-right: none !important; border-style: none none solid none !important;">
                                            <span t-esc="abs(line.total)" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td t-if="o.company_id.hao_allow_multi_payroll_currency" style="padding: 7px 8px; text-align: right; font-size: 12px; color: #111827; font-weight: 500; border-bottom: 1px solid #f1f5f9 !important; border-top: none !important; border-left: none !important; border-right: none !important; border-style: none none solid none !important;">
                                            <span t-esc="abs(line.hao_secondary_total)" t-options='{"widget": "monetary", "display_currency": o.company_id.hao_secondary_payroll_currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td style="padding: 8px 8px; font-weight: 700; font-size: 12.5px; color: #111827; border-top: 1px solid #4b5563 !important; border-bottom: 1px solid #4b5563 !important; border-left: none !important; border-right: none !important; border-style: solid none !important;">Total Deductions</td>
                                    <td style="padding: 8px 8px; text-align: right; font-weight: 700; font-size: 12.5px; color: #111827; border-top: 1px solid #4b5563 !important; border-bottom: 1px solid #4b5563 !important; border-left: none !important; border-right: none !important; border-style: solid none !important;">
                                        <span t-esc="total_deductions_usd" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                    <td t-if="o.company_id.hao_allow_multi_payroll_currency" style="padding: 8px 8px; text-align: right; font-weight: 700; font-size: 12.5px; color: #111827; border-top: 1px solid #4b5563 !important; border-bottom: 1px solid #4b5563 !important; border-left: none !important; border-right: none !important; border-style: solid none !important;">
                                        <span t-esc="total_deductions_zwg" t-options='{"widget": "monetary", "display_currency": o.company_id.hao_secondary_payroll_currency_id}'/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- ══════════════════════════════════════════════════════════ -->
                <!-- NET PAY SUMMARY ROW (Showline V3 Totals Row Style)         -->
                <!-- ══════════════════════════════════════════════════════════ -->
                <t t-set="net_line" t-value="o.line_ids.filtered(lambda l: l.code == 'NET')"/>
                <div style="width: 100%; margin-top: 10px; margin-bottom: 20px; overflow: hidden; clear: both;">
                    <div style="float: right; width: 48%; border-top: 1.5px solid #111827; border-bottom: 1.5px solid #111827; padding: 10px 12px; box-sizing: border-box; overflow: hidden; clear: both; background: #f8fafc;">
                        <div style="float: left; width: 35%; text-align: left; font-weight: 700; font-size: 14px; color: #111827; text-transform: uppercase; padding-top: 2px;">
                            NET PAY
                        </div>
                        <div style="float: right; width: 65%; text-align: right;">
                            <div style="font-weight: 800; font-size: 16px; color: #111827;">
                                <span t-esc="o.net_wage" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </div>
                            <div t-if="o.company_id.hao_allow_multi_payroll_currency and net_line" style="font-size: 13.5px; font-weight: 600; color: #4b5563; margin-top: 3px;">
                                <span t-esc="net_line[0].hao_secondary_total" t-options='{"widget": "monetary", "display_currency": o.company_id.hao_secondary_payroll_currency_id}'/>
                            </div>
                        </div>
                    </div>
                </div>

                <div t-if="tax_credit_lines" style="font-size: 12px; line-height: 1.6; color: #4b5563; margin-top: 15px;">
                    <t t-foreach="tax_credit_lines" t-as="tc">
                        <div><strong style="color: #111827;"><span t-esc="tc.name"/>:</strong> <span t-esc="abs(tc.total)" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/> <t t-if="o.company_id.hao_allow_multi_payroll_currency"><span style="margin-left: 10px;" t-esc="abs(tc.hao_secondary_total)" t-options='{"widget": "monetary", "display_currency": o.company_id.hao_secondary_payroll_currency_id}'/></t></div>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <record id="hr_payslip_form_inherit_havano" model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit.havano</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='top']" position="after">
                <group name="hao_leave_balances" string="Annual Leave Balances" class="alert alert-info">
                    <group>
                        <field name="annual_leave_allocated" string="Allocated (Days)" readonly="1"/>
                        <field name="annual_leave_taken" string="Taken (Days)" readonly="1"/>
                    </group>
                    <group>
                        <field name="annual_leave_balance" string="Remaining Balance (Days)" readonly="1" class="fw-bold text-success"/>
                        <field name="leave_allocation_id" string="Accrual Allocation" readonly="1" invisible="not leave_allocation_id"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//field[@name='line_ids']" position="before">
                <field name="hao_has_secondary_wage" invisible="1"/>
            </xpath>
            
            <xpath expr="//field[@name='worked_days_line_ids']/list/field[@name='amount']" position="attributes">
                <attribute name="string">Amount (USD)</attribute>
            </xpath>
            <xpath expr="//field[@name='worked_days_line_ids']/list/field[@name='amount']" position="after">
                <field name="hao_secondary_amount" optional="show" string="Amount (ZWG)" sum="Total ZWG"/>
            </xpath>
            
            <xpath expr="//field[@name='line_ids']/list/field[@name='quantity']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='salary_rule_id']" position="attributes">
                <attribute name="optional">show</attribute>
                <attribute name="groups"></attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='amount']" position="attributes">
                <attribute name="string">Amount (USD)</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='amount']" position="after">
                <field name="hao_secondary_amount" optional="show" string="Amount (ZWG)"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='total']" position="attributes">
                <attribute name="string">Total (USD)</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='total']" position="after">
                <field name="hao_secondary_total" optional="show" string="Total (ZWG)"/>
                <field name="hao_allow_multi_payroll_currency" column_invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']" position="attributes">
                <attribute name="context">{'default_slip_id': id}</attribute>
            </xpath>
        </field>
    </record>

    <!-- Inject Secondary Wages into Payslip Tree View -->
    <record id="view_hr_payslip_tree_inherit_havano" model="ir.ui.view">
