<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_havano_payroll_settings_form" model="ir.ui.view">
        <field name="name">havano.payroll.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_payroll.res_config_settings_view_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='hr_payroll_settings']" position="after">

                <block title="Havano Payroll" id="havano_payroll_settings">

                    <!-- PAYE Calculation Method -->
                    <setting string="PAYE Calculation Method" help="Choose how PAYE tax is calculated. Non-FDS calculates each period independently. FDS (Final Deduction System) calculates cumulatively over the tax year (Jan-Dec) to ensure the correct total tax is withheld, as required by ZIMRA.">
                        <div class="content-group mt16">
                            <label for="tax_calculation_method" class="o_light_label"/>
                            <field name="tax_calculation_method" widget="radio"/>
                        </div>
                        <div class="content-group mt8" invisible="tax_calculation_method != 'fds'">
                            <label for="fds_method" class="o_light_label"/>
                            <field name="fds_method"/>
                        </div>
                    </setting>

                    <setting string="Payslip Formatting" help="Configure the default payslip layout format.">
                        <div class="content-group mt16">
                            <label for="payslip_format" class="o_light_label"/>
                            <field name="payslip_format"/>
                        </div>
                    </setting>

                    <!-- Statutory Contributions -->
                    <setting string="Statutory Contributions" help="Configure statutory contribution percentages.">
                        <div class="content-group mt16">
                            <label for="hao_zimdef_percentage" class="o_light_label"/>
                            <field name="hao_zimdef_percentage"/>
                        </div>
                    </setting>

                    <!-- Fixed Tax Credits -->
                    <setting string="Fixed Tax Credits" help="Configure fixed tax credits for specific groups.">
                        <div class="content-group mt16">
                            <label for="havano_tax_credit_blind" class="o_light_label"/>
                            <field name="havano_tax_credit_blind"/>
                        </div>
                        <div class="content-group">
                            <label for="havano_tax_credit_elderly" class="o_light_label"/>
                            <field name="havano_tax_credit_elderly"/>
                        </div>
                        <div class="content-group">
                            <label for="havano_tax_credit_disabled" class="o_light_label"/>
                            <field name="havano_tax_credit_disabled"/>
                        </div>
                    </setting>

                </block>

            </xpath>
        </field>
    </record>



</odoo>