                <filter string="Current Month" name="current_month" domain="[('date_from', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d')), ('date_from', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter string="Pay Run" name="group_batch" context="{'group_by':'payslip_run_id'}"/>
