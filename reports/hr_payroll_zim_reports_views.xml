    <record id="action_havano_nssa_p4_report_tree_only" model="ir.actions.act_window">
        <field name="name">NSSA P4 Report</field>
        <field name="res_model">havano.nssa.p4.report</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_havano_nssa_p4_report_search"/>
    </record>


    <!-- ============================================== -->
    <!-- NSSA REPORT EMPLOYER -->
    <!-- ============================================== -->
