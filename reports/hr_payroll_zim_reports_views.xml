    </record>

    <record id="action_havano_nssa_employer_report_tree_only" model="ir.actions.act_window">
        <field name="name">NSSA Report Employer</field>
        <field name="res_model">havano.nssa.employer.report</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_havano_nssa_employer_report_search"/>
    </record>

    <!-- MENUS -->
    <menuitem id="menu_hr_payroll_report_zim" name="Havano Zimbabwean Reports" parent="hr_payroll.menu_hr_payroll_report" sequence="100"/>
    <menuitem id="menu_havano_nec_report" name="NEC Report" parent="menu_hr_payroll_report_zim" action="action_wizard_nec_report" sequence="10"/>
    <menuitem id="menu_havano_nssa_p4_report" name="NSSA P4 Report" parent="menu_hr_payroll_report_zim" action="action_wizard_nssa_p4_report" sequence="20"/>
    <menuitem id="menu_havano_nssa_employer_report" name="NSSA Report Employer" parent="menu_hr_payroll_report_zim" action="action_wizard_nssa_employer_report" sequence="30"/>
    <menuitem id="menu_havano_payroll_summary" name="Payroll Summary Report" parent="menu_hr_payroll_report_zim" action="action_wizard_payroll_summary" sequence="40"/>
    <menuitem id="menu_havano_salary_registry" name="Salary Registry Report" parent="menu_hr_payroll_report_zim" action="action_wizard_salary_registry" sequence="50"/>

</odoo>
