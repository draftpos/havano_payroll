<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================== -->
    <!-- NEC REPORT -->
    <!-- ============================================== -->
    <record id="view_havano_nec_report_tree" model="ir.ui.view">
        <field name="name">havano.nec.report.tree</field>
        <field name="model">havano.nec.report</field>
        <field name="arch" type="xml">
            <list string="NEC Report" create="false" edit="false" delete="false">
                <header>
                    <button name="action_print_report" string="Print PDF" type="object" display="always" class="btn-primary"/>
                </header>
                <field name="payslip_run_id" column_invisible="1"/>
                <field name="hao_allow_multi_payroll_currency" column_invisible="1"/>
                <field name="surname"/>
                <field name="first_names"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="nec_earnings"/>
                <field name="sec_nec_earnings" column_invisible="not context.get('hao_allow_multi_payroll_currency')"/>
                <field name="employee_contribution"/>
                <field name="sec_employee_contribution" column_invisible="not context.get('hao_allow_multi_payroll_currency')"/>
                <field name="employer_contribution"/>
                <field name="sec_employer_contribution" column_invisible="not context.get('hao_allow_multi_payroll_currency')"/>
                <field name="total_nec"/>
                <field name="sec_total_nec" column_invisible="not context.get('hao_allow_multi_payroll_currency')"/>
                <field name="company_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_havano_nec_report_search" model="ir.ui.view">
        <field name="name">havano.nec.report.search</field>
        <field name="model">havano.nec.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="first_names"/>
                <field name="payslip_run_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <filter string="Current Month" name="current_month" domain="[('date_from', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d')), ('date_from', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter string="Pay Run" name="group_batch" context="{'group_by':'payslip_run_id'}"/>
                    <filter string="Employee" name="group_employee" context="{'group_by':'employee_id'}"/>
                    <filter string="Period" name="group_period" context="{'group_by':'date_from:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_havano_nec_report_tree_only" model="ir.actions.act_window">
        <field name="name">NEC Report</field>
        <field name="res_model">havano.nec.report</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_havano_nec_report_search"/>
    </record>


