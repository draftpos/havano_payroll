                <field name="surname"/>
                <field name="period"/>
                <field name="nssa_usd_employee"/>
                <field name="nssa_zig_employee" column_invisible="not context.get('hao_allow_multi_payroll_currency')"/>
                <field name="nssa_usd_employer"/>
                <field name="nssa_zig_employer" column_invisible="not context.get('hao_allow_multi_payroll_currency')"/>
