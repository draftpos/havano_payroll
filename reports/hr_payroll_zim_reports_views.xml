                </header>
                <field name="payslip_run_id" column_invisible="1"/>
                <field name="hao_allow_multi_payroll_currency" column_invisible="1"/>
                <field name="surname"/>
                <field name="first_names"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="insurable_earnings"/>
                <field name="sec_insurable_earnings" column_invisible="not context.get('hao_allow_multi_payroll_currency')"/>
                <field name="current_contributions"/>
                <field name="sec_current_contributions" column_invisible="not context.get('hao_allow_multi_payroll_currency')"/>
                <field name="arrears"/>
                <field name="prepayments"/>
                <field name="surcharge"/>
                <field name="total_payment"/>
                <field name="sec_total_payment" column_invisible="not context.get('hao_allow_multi_payroll_currency')"/>
                <field name="employer_payment"/>
                <field name="sec_employer_payment" column_invisible="not context.get('hao_allow_multi_payroll_currency')"/>
                <field name="company_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_havano_nssa_p4_report_search" model="ir.ui.view">
        <field name="name">havano.nssa.p4.report.search</field>
        <field name="model">havano.nssa.p4.report</field>
        <field name="arch" type="xml">
            <search>
